{
  "name": "twilio-browser-phone",
  "version": "1.0.0",
  "description": "Receive (and make) Twilio calls from your browser via WebRTC",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "build": "mkdir -p public/vendor && cp node_modules/@twilio/voice-sdk/dist/twilio.min.js public/vendor/twilio.min.js",
    "vercel-build": "npm run build",
    "prestart": "npm run build",
    "predev": "npm run build",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "dependencies": {
    "@twilio/voice-sdk": "^2.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "twilio": "^5.3.0"
  }
}
