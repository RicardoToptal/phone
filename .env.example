# ── Required (to receive calls) ────────────────────────────────
# Account SID from https://console.twilio.com (starts with AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Key — create at Console > Account > API keys & tokens (Standard key).
# You get an SID (SK...) and a Secret (shown ONCE).
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret

# Any label for your browser client. Just leave it as "agent".
CLIENT_IDENTITY=agent

# ── Optional (only if you also want to PLACE calls from the browser) ──
# A TwiML App SID (Console > Voice > TwiML > TwiML Apps). Its Voice URL
# must point to https://<your-ngrok-url>/voice  (POST).
TWILIO_TWIML_APP_SID=
# Your Twilio phone number in E.164, used as the caller ID for outbound calls.
TWILIO_CALLER_ID=+1xxxxxxxxxx

# Local port
PORT=3000
